         return regex_find_int(r"; total layers count = (%D)", self.footer_data)
 
     def parse_line_width(self) -> Optional[float]:
+        # Orca states line widths as a percentage of the nozzle diameter ("line_width = 105%").
+        # Reporting that as an absolute 105.0 mm is worse than reporting nothing: every consumer
+        # then rejects it as out of range. Report the percentage separately instead, and let the
+        # consumer resolve it against the diameter of the extruder it is actually working on.
+        if regex_find_string(r";\sline_width\s=\s(%S)\n", self.footer_data or "") is not None:
+            raw = regex_find_string(r";\sline_width\s=\s(%S)\n", self.footer_data)
+            if raw is not None and raw.strip().endswith('%'):
+                return None
         return regex_find_float(r";\sline_width\s=\s(%F)", self.footer_data)
 
+    def parse_line_width_percent(self) -> Optional[float]:
+        raw = regex_find_string(r";\sline_width\s=\s(%S)\n", self.footer_data)
+        if raw is not None and raw.strip().endswith('%'):
+            return regex_find_float(r"(%F)", raw.strip()[:-1])
+        return None
+
