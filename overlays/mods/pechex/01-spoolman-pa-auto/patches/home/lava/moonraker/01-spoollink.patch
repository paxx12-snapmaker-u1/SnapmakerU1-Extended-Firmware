+    async def _spoolman_save_pa(self, spool_id: int, pa_value: float) -> dict:
+        await self._ensure_fields()
+        encoded = json.dumps(round(float(pa_value), 6))
+        resp = await self.http_client.request(
+            "PATCH", f"{self._spoolman_url}/api/v1/spool/{spool_id}",
+            body={"extra": {"pressure_advance": encoded}})
+        if resp.status_code == 200:
+            logging.info("[spoollink] saved pressure_advance %.6f to spool #%d", pa_value, spool_id)
+            return resp.json()
+        raise RuntimeError(f"HTTP {resp.status_code}: {resp.text}")
+
+    async def _handle_remote_save_pa(self, spool_id: Any = None, pa_value: Any = None, **kwargs) -> None:
