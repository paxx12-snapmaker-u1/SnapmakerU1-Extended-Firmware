+def _parse_pa_matrix(raw: Any) -> Dict[str, float]:
+    if not raw:
+        return {}
+    if isinstance(raw, dict):
+        return raw
+    if isinstance(raw, str):
+        s = raw.strip()
+        if not s:
+            return {}
+        try:
+            val = json.loads(s)
+            if isinstance(val, dict):
+                return val
+            if isinstance(val, str):
+                val2 = json.loads(val)
+                if isinstance(val2, dict):
+                    return val2
+        except (ValueError, TypeError):
+            pass
+        try:
+            unquoted = _unquote(s)
+            val = json.loads(unquoted)
+            if isinstance(val, dict):
+                return val
+            if isinstance(val, str):
+                val2 = json.loads(val)
+                if isinstance(val2, dict):
+                    return val2
+        except (ValueError, TypeError):
+            pass
+    return {}
+
