+    async def _spoolman_get_spool(self, spool_id: int) -> dict:
+        resp = await self.http_client.get(
+            f"{self._spoolman_url}/api/v1/spool/{spool_id}", enable_cache=False)
+        if resp.status_code == 200:
+            return resp.json()
+        raise RuntimeError(f"HTTP {resp.status_code}: {resp.text()}")
+
+    async def _spoolman_save_pa(self, spool_id: int, nozzle_key: str, pa_value: float) -> dict:
+        # Persist the calibrated Pressure Advance into a per-nozzle JSON matrix
+        # stored in the spool's `extra.pressure_advance_matrix` field. The matrix
+        # is keyed by "<nozzle_diameter>_<nozzle_volume_type>" (e.g. "0.4_standard").
+        # Existing entries are preserved (merge, not overwrite).
+        await self._ensure_fields()
+        matrix: dict = {}
+        try:
+            spool = await self._spoolman_get_spool(spool_id)
+            extra = spool.get("extra") or {}
+            raw_matrix = _unquote(str(extra.get("pressure_advance_matrix") or ""))
+            if raw_matrix:
+                parsed = json.loads(raw_matrix)
+                if isinstance(parsed, dict):
+                    matrix = parsed
+        except Exception as e:
+            logging.warning("[spoollink] could not read existing PA matrix for spool #%d: %s", spool_id, e)
+        matrix[nozzle_key] = round(float(pa_value), 6)
+        encoded = json.dumps(json.dumps(matrix))
+        resp = await self.http_client.request(
+            "PATCH", f"{self._spoolman_url}/api/v1/spool/{spool_id}",
+            body={"extra": {"pressure_advance_matrix": encoded}})
+        if resp.status_code == 200:
+            logging.info("[spoollink] saved pressure_advance %.6f (%s) to spool #%d", pa_value, nozzle_key, spool_id)
+            return resp.json()
+        raise RuntimeError(f"HTTP {resp.status_code}: {resp.text}")
+
+    async def _handle_remote_save_pa(self, spool_id: Any = None, nozzle_key: Any = None, pa_value: Any = None, **kwargs) -> None:
+        try:
+            spool_id_int = int(spool_id)
+            pa_val_float = float(pa_value)
+            key = str(nozzle_key or "").strip()
+            if not key:
+                raise ValueError("missing nozzle_key")
+            await self._retry(self._spoolman_save_pa, spool_id_int, key, pa_val_float)
+        except Exception as e:
+            logging.error("[spoollink] save PA failed for spool %s (%s): %s", spool_id, nozzle_key, e, exc_info=True)
 
