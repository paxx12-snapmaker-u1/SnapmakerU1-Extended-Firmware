#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-PackageHomePage: https://github.com/paxx12-snapmaker-u1/SnapmakerU1-Extended-Firmware
# SPDX-FileCopyrightText: Copyright (c) 2026 @noon92
#
# The harness for pushraker (https://github.com/noon92/pushraker), the push
# notifications package, on the Snapmaker U1 extended firmware:
#
#   pushraker-pkg enable          install it into its own venv under
#                                 /oem/apps/pushraker (from the update
#                                 channel, below), wire it into Moonraker
#                                 and Klipper, move older settings over,
#                                 restart
#   pushraker-pkg disable         unwire it and remove the venv (settings stay)
#   pushraker-pkg wire            (service start) put the wiring back after a
#                                 firmware upgrade replaced the root filesystem
#   pushraker-pkg upgrade         install the newest from the channel
#   pushraker-pkg channel <c>     switch the update channel and reinstall
#   pushraker-pkg needs_upgrade   exit 0 when Firmware Config should offer
#                                 the upgrade (a newer release; always on
#                                 the GitHub channel)
#   pushraker-pkg upgrade_label   the upgrade button's text
#   pushraker-pkg status          one line
#
# Update channels ([pushraker] channel in extended2.cfg):
#   release   releases from PyPI, between PUSHRAKER_MIN_VERSION and
#             PUSHRAKER_MAX_VERSION (/usr/local/share/pushraker/version)
#   github    the newest commit on the repository's main branch, for
#             testing; the upgrade button is always there
#
# The package brings its own dependencies; here only Pillow is installed
# next to it, because the firmware already ships Apprise and requests for
# Moonraker (so --no-deps keeps the download small).

set -u

APP_DIR=/oem/apps/pushraker
VENV="$APP_DIR/venv"
WEB_LINK="$APP_DIR/web"
SOURCE_FILE="$APP_DIR/source"          # what is installed: "release 0.1.0" or "github main <sha>"
LATEST_FILE="$APP_DIR/latest-release"  # newest release in range, checked every LATEST_MAX_AGE
LATEST_MAX_AGE=21600                   # 6 hours
EXTENDED_CFG=/home/lava/printer_data/config/extended/extended2.cfg
DATA_DIR=/home/lava/printer_data
MOONRAKER_DIR=/home/lava/moonraker
SECRETS_FILE=/home/lava/printer_data/moonraker.secrets
ERROR_INDEX_URL="https://wiki.snapmaker.com/en/snapmaker_u1/troubleshooting/u1_error_codes"
PYPI_JSON="https://pypi.org/pypi/pushraker/json"
GITHUB_REPO="noon92/pushraker"
GITHUB_BRANCH=main
CURL=/usr/local/bin/curl
[[ -x "$CURL" ]] || CURL=curl
PUSHRAKER_MIN_VERSION=0.1.0
PUSHRAKER_MAX_VERSION=
# shellcheck disable=SC1091
[[ -f /usr/local/share/pushraker/version ]] && . /usr/local/share/pushraker/version

cfg_get() {
    /usr/local/bin/extended-config.py get "$EXTENDED_CFG" pushraker "$1" "$2" 2>/dev/null
}

enabled() {
    [[ "$(cfg_get enabled false)" == "true" ]]
}

channel() {
    case "$(cfg_get channel release)" in
        github) echo github ;;
        *) echo release ;;
    esac
}

installed() {
    [[ -x "$VENV/bin/python" ]] && "$VENV/bin/python" -c "import pushraker" 2>/dev/null
}

installed_version() {
    "$VENV/bin/python" -c 'import pushraker; print(pushraker.__version__)' 2>/dev/null
}

site_packages() {
    "$VENV/bin/python" -c "import sysconfig; print(sysconfig.get_paths()['purelib'])"
}

enter_actions_cgroup() {
    # pip doesn't fit firmware-config's 48M cgroup (see extended-pkg)
    # shellcheck disable=SC1091
    [ -f /usr/local/sbin/limits-helper.sh ] && . /usr/local/sbin/limits-helper.sh
    declare -F limits_enter >/dev/null && limits_enter actions max
}

# ---- versions ------------------------------------------------------------

# The newest release on PyPI within MIN..MAX (inclusive; pre-releases
# skipped), or nothing
latest_release_online() {
    "$CURL" -fsSL -m 15 "$PYPI_JSON" 2>/dev/null | python3 -c '
import json, re, sys
lo, hi = sys.argv[1], sys.argv[2]
def key(v):
    return tuple(int(x) for x in v.split("."))
try:
    releases = json.load(sys.stdin).get("releases") or {}
except ValueError:
    sys.exit(0)
ok = [v for v, files in releases.items()
      if re.fullmatch(r"\d+(\.\d+)*", v) and files
      and (not lo or key(v) >= key(lo)) and (not hi or key(v) <= key(hi))]
if ok:
    print(max(ok, key=key))
' "$PUSHRAKER_MIN_VERSION" "$PUSHRAKER_MAX_VERSION"
}

refresh_latest() {
    local v
    v=$(latest_release_online) || return 1
    [[ -n "$v" ]] || return 1
    mkdir -p "$APP_DIR"
    echo "$v" > "$LATEST_FILE.tmp" && mv "$LATEST_FILE.tmp" "$LATEST_FILE"
}

# The cached newest release; a stale cache is refreshed in the background
# (Firmware Config gives its checks 5 seconds and runs them on every load)
latest_release_cached() {
    local age=$LATEST_MAX_AGE
    if [[ -f "$LATEST_FILE" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$LATEST_FILE" 2>/dev/null || echo 0) ))
    fi
    if (( age >= LATEST_MAX_AGE )); then
        mkdir -p "$APP_DIR"
        touch "$LATEST_FILE" 2>/dev/null    # one refresh at a time
        setsid "$0" refresh_latest </dev/null >/dev/null 2>&1 &
    fi
    [[ -s "$LATEST_FILE" ]] && cat "$LATEST_FILE"
}

newer() {
    # $1 newer than $2 (dotted numbers)
    python3 -c '
import re, sys
def key(v):
    return tuple(int(x) for x in re.findall(r"\d+", v.split("+")[0])[:4])
sys.exit(0 if key(sys.argv[1]) > key(sys.argv[2]) else 1)
' "$1" "$2"
}

# ---- install -------------------------------------------------------------

legacy_cleanup() {
    # Firmware before pushraker generated these from extended2.cfg; left in
    # place they would define [push_notifications] and the _NTFY_* macros
    # a second time (Moonraker and Klipper refuse duplicate sections)
    rm -f "$DATA_DIR/config/extended/moonraker/notifications.cfg" \
          "$DATA_DIR/config/extended/klipper/notifications.cfg" \
          "$DATA_DIR/config/extended/.notifications-restart-moonraker" \
          "$DATA_DIR/config/extended/.notifications-restart-klipper"
}

wire() {
    # Everything pushraker needs in Moonraker's and Klipper's folders; safe
    # to repeat. The include folders are picked up by the extended
    # firmware's moonraker.conf and printer.cfg already.
    legacy_cleanup
    local sp
    sp=$(site_packages) || return 1
    "$VENV/bin/python" -m pushraker install \
        --moonraker-dir "$MOONRAKER_DIR" \
        --data-dir "$DATA_DIR" \
        --moonraker-include-dir "$DATA_DIR/config/extended/moonraker" \
        --klipper-include-dir "$DATA_DIR/config/extended/klipper" \
        --site-packages "$sp" \
        --name U1 --error-index-url "$ERROR_INDEX_URL" \
        --import-ini "$EXTENDED_CFG" notifications \
        --import-secrets "$SECRETS_FILE" notifications \
        --owner lava:lava || return 1
    ln -sfn "$sp/pushraker/web" "$WEB_LINK"
}

unwire() {
    if installed; then
        "$VENV/bin/python" -m pushraker uninstall \
            --moonraker-dir "$MOONRAKER_DIR" \
            --data-dir "$DATA_DIR" \
            --moonraker-include-dir "$DATA_DIR/config/extended/moonraker" \
            --klipper-include-dir "$DATA_DIR/config/extended/klipper" \
            --owner lava:lava
    else
        rm -f "$MOONRAKER_DIR/moonraker/components/push_notifications.py" \
              "$DATA_DIR/config/extended/moonraker/pushraker.cfg" \
              "$DATA_DIR/config/extended/klipper/pushraker.cfg"
    fi
    rm -f "$WEB_LINK"
}

ensure_venv() {
    mkdir -p "$APP_DIR"
    if [[ ! -x "$VENV/bin/python" ]]; then
        echo ">> Setting up a Python virtual environment (up to 60 seconds)..."
        if ! python3 -m venv "$VENV"; then
            echo "ERROR: could not create the virtual environment"
            rm -rf "$VENV"
            return 1
        fi
    fi
}

install_pillow() {
    echo ">> Installing Pillow (spool pictures)..."
    "$VENV/bin/pip" install --disable-pip-version-check --upgrade "Pillow>=10" || return 1
}

install_release() {
    local spec="pushraker>=$PUSHRAKER_MIN_VERSION"
    [[ -n "$PUSHRAKER_MAX_VERSION" ]] && spec="$spec,<=$PUSHRAKER_MAX_VERSION"
    echo ">> Installing $spec from PyPI (this can take a minute)..."
    if ! "$VENV/bin/pip" install --disable-pip-version-check --no-deps --upgrade "$spec"; then
        echo "ERROR: the download from PyPI failed. Is the printer online?"
        return 1
    fi
    install_pillow || return 1
    echo "release $(installed_version)" > "$SOURCE_FILE"
}

install_github() {
    # The branch's newest commit, as a source archive: pip builds it
    # without git (which the printer doesn't have)
    local sha
    sha=$("$CURL" -fsSL -m 15 -H "Accept: application/vnd.github.sha" \
        "https://api.github.com/repos/$GITHUB_REPO/commits/$GITHUB_BRANCH" 2>/dev/null)
    if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then
        echo "ERROR: could not reach GitHub for the newest commit of $GITHUB_REPO ($GITHUB_BRANCH)"
        return 1
    fi
    echo ">> Installing pushraker from GitHub, $GITHUB_BRANCH at ${sha:0:7} (this can take a minute)..."
    if ! "$VENV/bin/pip" install --disable-pip-version-check --no-deps --force-reinstall \
            "https://github.com/$GITHUB_REPO/archive/$sha.tar.gz"; then
        echo "ERROR: installing from GitHub failed"
        return 1
    fi
    install_pillow || return 1
    echo "github $GITHUB_BRANCH ${sha:0:7}" > "$SOURCE_FILE"
}

install_from_channel() {
    if [[ "$(channel)" == github ]]; then
        install_github
    else
        install_release
    fi
}

printing() {
    # Enable, disable, upgrade and a channel switch restart Klipper, which
    # ends a print job: refuse while one runs (unreachable Moonraker
    # counts as idle)
    local state
    state=$("$CURL" -s -m 5 "http://127.0.0.1:7125/printer/objects/query?print_stats=state" 2>/dev/null \
        | sed -n 's/.*"state": *"\([a-z]*\)".*/\1/p')
    [[ "$state" == "printing" || "$state" == "paused" ]]
}

refuse_if_printing() {
    if printing; then
        echo "ERROR: the printer is printing. This restarts Klipper, which would end the print job: try again when it is done."
        return 1
    fi
}

restart_services() {
    echo ">> Restarting Klipper..."
    /etc/init.d/S60klipper restart || echo "WARNING: Klipper restart failed"
    echo ">> Restarting Moonraker..."
    /etc/init.d/S61moonraker restart || echo "WARNING: Moonraker restart failed"
}

describe_installed() {
    local src
    src=$(cat "$SOURCE_FILE" 2>/dev/null)
    case "$src" in
        github*) echo "pushraker $(installed_version) (GitHub ${src#github })" ;;
        *) echo "pushraker $(installed_version)" ;;
    esac
}

# ---- commands --------------------------------------------------------------

cmd_enable() {
    refuse_if_printing || return 1
    enter_actions_cgroup
    ensure_venv || return 1
    install_from_channel || return 1
    echo ">> Wiring pushraker into Moonraker and Klipper..."
    if ! wire; then
        echo "ERROR: could not set pushraker up"
        return 1
    fi
    /usr/local/bin/extended-config.py add "$EXTENDED_CFG" pushraker enabled true
    restart_services
    rm -f "$LATEST_FILE"
    echo
    echo "$(describe_installed) is enabled."
    echo "Set it up on the notifications page: http://$(hostname 2>/dev/null || echo printer)/notifications/"
    echo "(also linked from the Links list at the top of Firmware Config)."
}

cmd_disable() {
    refuse_if_printing || return 1
    echo ">> Removing pushraker from Moonraker and Klipper..."
    legacy_cleanup
    unwire
    /usr/local/bin/extended-config.py add "$EXTENDED_CFG" pushraker enabled false
    rm -rf "$APP_DIR"
    restart_services
    echo "pushraker is disabled. Its settings (pushraker.conf) are kept for next time."
}

cmd_wire() {
    # Service start: the old generated files go whatever the state; the
    # rest only when enabled. Never fail the start.
    legacy_cleanup
    enabled || return 0
    if ! installed; then
        echo "pushraker: enabled but not installed (python3 -m venv failed, or the firmware's Python changed); run Enable again" >&2
        return 0
    fi
    wire >/dev/null 2>&1 || echo "pushraker: wiring failed" >&2
    return 0
}

cmd_upgrade() {
    refuse_if_printing || return 1
    enter_actions_cgroup
    if ! installed; then
        echo "pushraker is not installed. Enable it first."
        return 1
    fi
    echo "Installed: $(describe_installed)"
    install_from_channel || return 1
    wire || return 1
    restart_services
    rm -f "$LATEST_FILE"
    echo "$(describe_installed) installed."
}

cmd_channel() {
    local want=${1:-}
    case "$want" in
        release|github) ;;
        *) echo "Usage: pushraker-pkg channel release|github"; return 1 ;;
    esac
    if enabled && installed; then
        refuse_if_printing || return 1
    fi
    /usr/local/bin/extended-config.py add "$EXTENDED_CFG" pushraker channel "$want"
    if [[ "$want" == github ]]; then
        echo "Update channel: GitHub ($GITHUB_REPO, $GITHUB_BRANCH). For testing: every upgrade installs the newest commit."
    else
        echo "Update channel: releases from PyPI."
    fi
    if ! enabled || ! installed; then
        echo "pushraker is not enabled; the channel is used when it is."
        return 0
    fi
    enter_actions_cgroup
    echo "Installed: $(describe_installed)"
    if [[ "$want" == release ]]; then
        # Back from GitHub: the release replaces whatever main had, even
        # when main carries the same version number
        "$VENV/bin/pip" uninstall -y -q pushraker >/dev/null 2>&1
    fi
    install_from_channel || return 1
    wire || return 1
    restart_services
    rm -f "$LATEST_FILE"
    echo "$(describe_installed) installed."
}

cmd_needs_upgrade() {
    enabled && installed || return 1
    [[ "$(channel)" == github ]] && return 0
    local latest
    latest=$(latest_release_cached)
    [[ -n "$latest" ]] && newer "$latest" "$(installed_version)"
}

cmd_upgrade_label() {
    if [[ "$(channel)" == github ]]; then
        echo "Upgrade pushraker from GitHub ($GITHUB_BRANCH)"
    else
        local latest
        latest=$(latest_release_cached)
        echo "Upgrade pushraker to ${latest:-the latest release}"
    fi
}

cmd_status() {
    if ! enabled; then
        echo "Disabled"
    elif installed; then
        echo "Enabled ($(describe_installed | sed 's/^pushraker //'))"
    else
        echo "Enabled, not installed"
    fi
}

case "${1:-}" in
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    wire) cmd_wire ;;
    upgrade) cmd_upgrade ;;
    channel) cmd_channel "${2:-}" ;;
    needs_upgrade) cmd_needs_upgrade ;;
    upgrade_label) cmd_upgrade_label ;;
    refresh_latest) refresh_latest ;;
    status) cmd_status ;;
    *) echo "Usage: pushraker-pkg enable|disable|wire|upgrade|channel <release|github>|needs_upgrade|upgrade_label|status"; exit 1 ;;
esac
