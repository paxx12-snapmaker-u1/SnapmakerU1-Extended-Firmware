From 8754407ae225f6b99c0a6232014bb459477d3c95 Mon Sep 17 00:00:00 2001
From: Alan de Bortolo <info@designmastersolutions.com>
Date: Wed, 4 Nov 2026 23:33:33 +0000
Subject: [PATCH] fan: schedule G-code fan changes with motion

M106/M107 and SET_FAN_SPEED currently schedule PWM from reactor time, before
the queued toolhead motion reaches the command. Use a toolhead lookahead
callback so G-code fan changes are scheduled at the print time of the
following move. Webhooks and tool-change fan control remain immediate.
The fan status keeps the stock 'speed': last_fan_value, which the callback
updates when it schedules the PWM (the same point at which mainline Klipper
updates last_req_value), so status does not report a speed that is still
waiting behind queued moves. Queued requests are visible to state saves
(SAVE_GCODE_STATE and the power-loss fan record) through
get_requested_speed().

Suggested-by: alternativniy (Snapmaker/u1-klipper#18)
---
 klippy/extras/fan.py            | 26 ++++++++++++++++++++------
 klippy/extras/fan_generic.py    |  2 +-
 klippy/extras/virtual_sdcard.py |  3 +--
 3 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/klippy/extras/fan.py b/klippy/extras/fan.py
index 0964ab0a..fa0d9d27 100644
--- a/klippy/extras/fan.py
+++ b/klippy/extras/fan.py
@@ -14,6 +14,8 @@ class Fan:
         self.reactor = self.printer.get_reactor()
         self.last_fan_value = 0.
         self.last_fan_time = 0.
+        self.requested_fan_value = 0.
+        self.pending_values = []
         self.last_enable_value = 0.
         # Read config
         self.max_power = config.getfloat('max_power', 1., above=0., maxval=1.)
@@ -49,6 +51,7 @@ class Fan:
     def get_mcu(self):
         return self.mcu_fan.get_mcu()
     def set_speed(self, print_time, value, control_enable=True):
+        self.requested_fan_value = value
         if value < self.off_below:
             value = 0.
         value = max(0., min(self.max_power, value * self.max_power))
@@ -84,6 +87,17 @@ class Fan:
         system_time += FAN_MIN_TIME
         print_time = self.get_mcu().estimated_print_time(system_time)
         self.set_speed(print_time, value, control_enable)
+    def set_speed_from_gcode(self, value, control_enable=True):
+        self.pending_values.append(value)
+        def apply_speed(print_time):
+            self.pending_values.pop(0)
+            self.set_speed(print_time, value, control_enable)
+        toolhead = self.printer.lookup_object('toolhead')
+        toolhead.register_lookahead_callback(apply_speed)
+    def get_requested_speed(self):
+        if self.pending_values:
+            return self.pending_values[-1]
+        return self.requested_fan_value
     def _handle_request_restart(self, print_time):
         self.set_speed(print_time, 0.)
 
@@ -158,12 +172,12 @@ class PrinterFan:
 
     def get_all_fan_speed(self):
         fan_speed_dict = {}
-        fan_speed_dict['main_fan'] = self.fan.last_fan_value
+        fan_speed_dict['main_fan'] = self.fan.get_requested_speed()
         fan_speed_dict['extendable_fan'] = {}
         for fan_id in self.extendable_fan:
             fan_obj = self.printer.lookup_object("fan_generic {}".format(self.extendable_fan[fan_id]), None)
             if fan_obj is not None:
-                fan_speed_dict['extendable_fan'][fan_id] = fan_obj.fan.last_fan_value
+                fan_speed_dict['extendable_fan'][fan_id] = fan_obj.fan.get_requested_speed()
             else:
                 logging.error("No fan found with ID {}".format(fan_id))
         return copy.deepcopy(fan_speed_dict)
@@ -189,13 +203,13 @@ class PrinterFan:
             if fan_id in self.extendable_fan:
                 fan_obj = self.printer.lookup_object("fan_generic {}".format(self.extendable_fan[fan_id]), None)
                 if fan_obj is not None:
-                    fan_obj.fan.set_speed_from_command(value)
+                    fan_obj.fan.set_speed_from_gcode(value)
                 else:
                     gcmd.respond_info("M106: No fan found with ID {}".format(fan_id))
             else:
                 gcmd.respond_info("M106: Unsupported fan ID: {}".format(fan_id))
         else:
-            self.fan.set_speed_from_command(value)
+            self.fan.set_speed_from_gcode(value)
     def cmd_M107(self, gcmd):
         # Turn fan off
         fan_id = gcmd.get_int('P', None)
@@ -203,13 +217,13 @@ class PrinterFan:
             if fan_id in self.extendable_fan:
                 fan_obj = self.printer.lookup_object("fan_generic {}".format(self.extendable_fan[fan_id]), None)
                 if fan_obj is not None:
-                    fan_obj.fan.set_speed_from_command(0.)
+                    fan_obj.fan.set_speed_from_gcode(0.)
                 else:
                     gcmd.respond_info("M107: No fan found with ID {}".format(fan_id))
             else:
                 gcmd.respond_info("M107: Unsupported fan ID: {}".format(fan_id))
         else:
-            self.fan.set_speed_from_command(0.)
+            self.fan.set_speed_from_gcode(0.)
 
 def load_config(config):
     return PrinterFan(config)
diff --git a/klippy/extras/fan_generic.py b/klippy/extras/fan_generic.py
index 425c5ca9..f5bdad55 100644
--- a/klippy/extras/fan_generic.py
+++ b/klippy/extras/fan_generic.py
@@ -36,7 +36,7 @@ class PrinterFanGeneric:
         return self.fan.get_status(eventtime)
     def cmd_SET_FAN_SPEED(self, gcmd):
         speed = gcmd.get_float('SPEED', 0.)
-        self.fan.set_speed_from_command(speed)
+        self.fan.set_speed_from_gcode(speed)
 
 def load_config_prefix(config):
     return PrinterFanGeneric(config)
diff --git a/klippy/extras/virtual_sdcard.py b/klippy/extras/virtual_sdcard.py
index bc847fa0..78f77a1d 100644
--- a/klippy/extras/virtual_sdcard.py
+++ b/klippy/extras/virtual_sdcard.py
@@ -1002,8 +1002,7 @@ class VirtualSD:
                 # self.gcode.respond_info("fan key: {}".format(key))
                 if fan_obj is not None:
                     curtime = self.reactor.monotonic()
-                    fan_sta = fan_obj.get_status(curtime)
-                    fan_value = int(fan_sta[fan_info[key][2]] * 255)
+                    fan_value = int(fan_obj.fan.get_requested_speed() * 255)
                     fan_state[key] = fan_info[key][1] + ' S{}'.format(fan_value)
         fan_state.update(data_dict)
         self.save_environment_data(self.pl_print_fan_info_env_path, fan_state, sync, flush, safe_write)
