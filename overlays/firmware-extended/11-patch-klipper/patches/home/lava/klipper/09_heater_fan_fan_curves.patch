 PIN_MIN_TIME = 0.100
 
+# Fan curve support. The active profile is written to a JSON file by
+# firmware-config's fan_curves.py, which owns the user facing validation.
+# The checks below repeat the shape rules of that module: a file that was
+# edited by hand is refused and the stock behaviour runs.
+FAN_CURVES_PATH = os.environ.get(
+    'FAN_CURVES_PATH', '/oem/printer_data/config/extended/fan-curves-active.json')
+FAN_CURVE_MAX_POINTS = 16
+FAN_CURVE_MAX_TEMPERATURE = 300
+# The stock nozzle fan reaches 90%, so an ordinary curve has to be allowed to
+# go that high. The heavy-load rule reaches 100% as well.
+FAN_CURVE_MAX_DUTY = 1.0
+FAN_CURVE_DEFAULT_HYSTERESIS = 5.0
+# The Faulty Toolhead Bypass raises the heater_temp of the affected nozzle
+# cooling fan to 999 and zeroes the last stepped_temp_table entry. A profile
+# must not take that fan back over.
+FAULTY_TOOLHEAD_BYPASS_TEMPERATURE = 999
+
+
+def _load_curve(fan_name):
+    try:
+        with open(FAN_CURVES_PATH, 'r', encoding='utf-8') as stream:
+            document = json.load(stream)
+        if not isinstance(document, dict) or document.get('version') != 1:
+            raise ValueError('unsupported version')
+        profile = document.get('profile')
+        if profile == 'stock':
+            return None
+        if not isinstance(profile, str) or not profile.strip():
+            raise ValueError('unknown profile')
+        curves = document.get('curves')
+        if not isinstance(curves, dict):
+            raise ValueError('curves must be an object')
+        curve_name = 'power' if fan_name == 'power_fan' else 'nozzle'
+        points = curves.get(curve_name)
+        if not isinstance(points, list) or len(points) < 2 or len(points) > FAN_CURVE_MAX_POINTS:
+            raise ValueError('curve must contain 2-%d points' % FAN_CURVE_MAX_POINTS)
+        normalized = []
+        previous_temperature = None
+        for point in points:
+            if not isinstance(point, list) or len(point) != 2:
+                raise ValueError('curve point must contain two values')
+            temperature, duty = float(point[0]), float(point[1])
+            if not math.isfinite(temperature) or not math.isfinite(duty):
+                raise ValueError('curve point must be finite')
+            if temperature != int(temperature) or not 0 <= temperature <= FAN_CURVE_MAX_TEMPERATURE:
+                raise ValueError('curve temperature is out of range')
+            if not 0 <= duty <= FAN_CURVE_MAX_DUTY:
+                raise ValueError('curve duty is out of range')
+            if previous_temperature is not None and temperature <= previous_temperature:
+                raise ValueError('curve temperatures are not ascending')
+            normalized.append((temperature, duty))
+            previous_temperature = temperature
+        hysteresis = float(document.get('hysteresis', FAN_CURVE_DEFAULT_HYSTERESIS))
+        if not math.isfinite(hysteresis) or not 0 <= hysteresis <= FAN_CURVE_MAX_TEMPERATURE:
+            raise ValueError('hysteresis is out of range')
+        heavy_load = document.get('heavy_load')
+        if heavy_load is None:
+            heavy_load = {}
+        if not isinstance(heavy_load, dict):
+            raise ValueError('heavy-load values must be an object')
+        # The power fan reaches heavy_duty when at least heavy_count toolheads
+        # heat up and at least heavy_hot of them target more than
+        # heavy_temperature. A heavy_count of zero drops the first condition.
+        heavy_temperature = float(heavy_load.get('temperature', 260))
+        heavy_heaters = float(heavy_load.get('heater_count', 3))
+        heavy_hot = float(heavy_load.get('hot_count', 1))
+        heavy_duty = float(heavy_load.get('duty', 1.0))
+        if not all(math.isfinite(value) for value in
+                   (heavy_temperature, heavy_heaters, heavy_hot, heavy_duty)):
+            raise ValueError('heavy-load values must be finite')
+        if (heavy_heaters != int(heavy_heaters) or heavy_heaters < 0
+                or heavy_hot != int(heavy_hot) or heavy_hot < 1
+                or not 0 <= heavy_temperature <= FAN_CURVE_MAX_TEMPERATURE
+                or not 0 <= heavy_duty <= 1):
+            raise ValueError('heavy-load trigger is out of range')
+        return {
+            'points': normalized,
+            'hysteresis': hysteresis,
+            'heavy_temperature': heavy_temperature,
+            'heavy_count': int(heavy_heaters),
+            'heavy_hot': int(heavy_hot),
+            'heavy_duty': heavy_duty,
+        }
+    except FileNotFoundError:
+        return None
+    except (AttributeError, OSError, ValueError, TypeError, KeyError,
+            json.JSONDecodeError) as error:
+        logging.warning('Invalid fan curve state: %s; using stock behaviour', error)
+        return None
+
