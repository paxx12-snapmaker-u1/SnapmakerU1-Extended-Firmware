+    def calculate_curve_fan_speed(self, temp):
+        # The curve is a straight line between its points, so the duty
+        # follows the temperature instead of jumping from step to step.
+        points = self.fan_curve['points']
+        speed = max(self.min_speed, min(self.interpolate_curve(points, temp), 1.0))
+        # The hysteresis holds the last duty while the temperature stays
+        # inside the band around it. A rising temperature is followed at
+        # once, a falling one waits, the same way the stock stepped table
+        # drops a step late.
+        if (speed < self.current_curve_speed
+                and temp > self.current_curve_temp - self.fan_curve['hysteresis']):
+            return self.current_curve_speed
+        self.current_curve_speed = speed
+        self.current_curve_temp = temp
+        return speed
+
+    def interpolate_curve(self, points, temp):
+        # The duty between two points is the line between them. Below the
+        # first point the fan is off.
+        if temp < points[0][0]:
+            return 0.0
+        if temp >= points[-1][0]:
+            return points[-1][1]
+        for index in range(1, len(points)):
+            low_temperature, low_duty = points[index - 1]
+            high_temperature, high_duty = points[index]
+            if temp < high_temperature:
+                span = high_temperature - low_temperature
+                if span <= 0:
+                    return high_duty
+                ratio = (temp - low_temperature) / span
+                return low_duty + (high_duty - low_duty) * ratio
+        return points[-1][1]
+
+    def reset_curve_state(self):
+        self.current_curve_speed = 0.0
+        self.current_curve_temp = 0.0
