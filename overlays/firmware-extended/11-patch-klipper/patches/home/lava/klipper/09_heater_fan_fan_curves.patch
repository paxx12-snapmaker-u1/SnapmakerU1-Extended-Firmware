+    def calculate_curve_fan_speed(self, temp):
+        points = self.fan_curve['points']
+        min_temp, max_temp = points[0][0], points[-1][0]
+        if temp < min_temp:
+            self.current_curve_index = -1
+            return 0.0
+        elif temp >= max_temp:
+            self.current_curve_index = len(points) - 1
+            speed = points[-1][1]
+            return max(self.min_speed, min(speed, 1.0))
+        target_index = -1
+        for i, (threshold, _) in enumerate(points):
+            if temp >= threshold:
+                target_index = i
+            else:
+                break
+        if target_index > self.current_curve_index:
+            self.current_curve_index = target_index
+        elif target_index < self.current_curve_index:
+            current_temp_threshold = points[self.current_curve_index][0]
+            if temp < (current_temp_threshold - self.fan_curve['hysteresis']):
+                self.current_curve_index = target_index
+        if self.current_curve_index >= 0:
+            speed = points[self.current_curve_index][1]
+            return max(self.min_speed, min(speed, 1.0))
+        else:
+            return 0.0
