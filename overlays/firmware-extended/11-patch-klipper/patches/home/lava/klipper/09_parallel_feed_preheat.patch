                     except:
                         logging.error("[feed][manual] stage: cancel, gcode error!\r\n")
+                    self._quench_hotends_on_cancel()
                     self._set_channel_state(ch, FEED_STA_MANUAL_FAIL, True)
                     self.channel_error_state[ch] = self.channel_state[ch]
 
@@ -1818,6 +1870,8 @@
                         self.gcode.run_script_from_command(f"M104 S{restore_temp_from_cmd} T{self.filament_ch[channel]} A0")
                     else:
                         self.gcode.run_script_from_command(f"M104 S{last_temp} T{self.filament_ch[channel]} A0")
