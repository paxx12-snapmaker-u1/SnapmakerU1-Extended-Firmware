#!/bin/sh

EXTENDED_CFG="/home/lava/printer_data/config/extended/extended2.cfg"
PRODUCT_INFO="/home/lava/printer_data/config/snapmaker/product_info.json"
DEVICE_NAME_SEED="/home/lava/printer_data/.device_name"
PIDFILE=/var/run/cmdnsd.pid

MDNS_ENABLED=$(/usr/local/bin/extended-config.py get "$EXTENDED_CFG" networking mdns_enabled false)

# Prefer the live printer name (set via the app / Moonraker's `machine` component)
# over the legacy seed file, over the Linux hostname (always "lava", not useful).
device_name() {
    if [ -f "$PRODUCT_INFO" ]; then
        # No `jq` on this rootfs; python3 is always present (Moonraker depends on it).
        name=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('device_name') or '')" "$PRODUCT_INFO" 2>/dev/null)
        [ -n "$name" ] && { echo "$name"; return; }
    fi
    if [ -f "$DEVICE_NAME_SEED" ]; then
        name=$(cat "$DEVICE_NAME_SEED")
        [ -n "$name" ] && { echo "$name"; return; }
    fi
    cat /etc/hostname
}

# The app-set device_name is free text (up to 32 chars per machine.py) and may
# contain spaces/punctuation that aren't valid DNS labels. Sanitize to
# alphanumeric + hyphen before handing to cmdnsd.
sanitize_label() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9-' '-' | sed -e 's/-\{2,\}/-/g' -e 's/^-*//' -e 's/-*$//'
}

start() {
    if [ "$MDNS_ENABLED" != "true" ]; then
        echo "mDNS is disabled in extended2.cfg, not starting."
        return
    fi

    MDNS_HOSTNAME=$(sanitize_label "$(device_name)")
    [ -z "$MDNS_HOSTNAME" ] && MDNS_HOSTNAME=$(sanitize_label "$(cat /etc/hostname)")
    printf "Starting cmdnsd (%s.local): " "$MDNS_HOSTNAME"
    start-stop-daemon -S -b -q -m -p "$PIDFILE" -x /usr/local/sbin/cmdnsd -- -H "$MDNS_HOSTNAME"
    echo "OK"
}

stop() {
    printf "Stopping cmdnsd: "
    start-stop-daemon -K -q -p "$PIDFILE"
    echo "OK"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
